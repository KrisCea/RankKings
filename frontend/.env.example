# URL pública del API Gateway. No apuntar directamente a un microservicio.
VITE_API_URL=http://localhost:8080/api

# Clave pública de Cloudflare Turnstile (opcional en desarrollo).
VITE_TURNSTILE_SITE_KEY=

# Sólo desarrollo local; requiere DEV_CAPTCHA_BYPASS=true en Identity Service.
VITE_DEV_CAPTCHA_BYPASS=false