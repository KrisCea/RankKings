# URL pública del API Gateway. No apuntar directamente a un microservicio.
VITE_API_URL=http://localhost:8080/api

# Clave pública de Cloudflare Turnstile (opcional en desarrollo).
VITE_TURNSTILE_SITE_KEY=

# Sólo desarrollo local; requiere DEV_CAPTCHA_BYPASS=true en Identity Service.
# Vite lo aplica por defecto cuando VITE_API_URL apunta a localhost.
VITE_DEV_CAPTCHA_BYPASS=true

# true muestra instrucciones para enlaces de verificación en el log local.
# Usa false tanto aquí como DEV_VERIFICATION_LOGGING=false para enviar correo real.
VITE_DEV_VERIFICATION_LOGGING=true